server {
    listen 80;
    server_name yourdomain.com;

    # Nginx trick: ZITADEL requires HTTP/2, but we need to route it locally.
    # The routes below map your domains to the Docker containers.

    # ZITADEL Login UI
    location /ui/v2/login/ {
        proxy_pass http://127.0.0.1:3000/ui/v2/login/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # MinIO API (Storage API)
    location /minio-api/ {
        rewrite ^/minio-api/(.*) /$1 break;
        proxy_pass http://127.0.0.1:9000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 50M; # Important to allow uploading passport images
    }

    # MinIO Web Console
    location /minio-console/ {
        proxy_pass http://127.0.0.1:9001/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ZITADEL Core API & Console
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # ZITADEL relies heavily on gRPC, so we support it here
        if ($content_type = 'application/grpc') {
            grpc_pass grpc://127.0.0.1:8080;
        }
    }
}